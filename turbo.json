{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "CLIAGENT_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "CLIAGENT_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "cliagent#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@cliagent/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@cliagent/function#test": {
      "outputs": []
    },
    "@cliagent/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@cliagent/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@cliagent/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
